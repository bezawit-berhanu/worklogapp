# =======================================================
# Personal Work Log - Database & TiDB Cloud Configuration
# =======================================================
# Instructions: Copy this file to .env and fill in your TiDB username and password.
# .env is ignored by git to protect your database credentials.

# TiDB Serverless / MySQL Connection Parameters
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=worklog

# Full Database Connection String for TiDB Cloud
DATABASE_URL=mysql://your_tidb_username:your_tidb_password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/worklog?ssl={"rejectUnauthorized":true}

# Application Mode
VITE_STORAGE_MODE=hybrid
