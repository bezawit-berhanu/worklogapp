{
  "name": "worklogapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test tests/analytics.test.js tests/*.test.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:check": "node --import tsx/esm scripts/tidb_test_connection.ts",
    "db:init": "node --import tsx/esm scripts/tidb_schema_create.ts",
    "db:seed": "node --import tsx/esm scripts/tidb_seed.ts",
    "validate": "node scripts/validate_suite.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tidbcloud/serverless": "^0.3.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
